# Copy to .env for local development. On Render, set these in the service's Environment tab.
PORT=8080
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional — enables the AI weekly coach (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional — only if you ever host a front end on a different domain (comma-separated)
FRONTEND_ORIGIN=
