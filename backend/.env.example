# Copy to .env for local development. On Render, set these in the service's Environment tab.
PORT=8080
# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Your Vercel URL, e.g. https://gold-desk-journal.vercel.app (comma-separate several)
FRONTEND_ORIGIN=https://gold-desk-journal.vercel.app
# Optional — enables the AI weekly coach (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
